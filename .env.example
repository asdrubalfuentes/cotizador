############################################
# Backend / Servidor
############################################

# Puerto HTTP (local/desarrollo). En cPanel/Passenger puede ignorarse.
PORT=5000

# HTTPS directo en Node (opcional). Si es true, usa HTTPS_PORT y certificados.
HTTPS=false
HTTPS_ENABLE=false
HTTPS_PORT=8443
TLS_CERT_FILE=/etc/ssl/emqx/emqx.crt
TLS_KEY_FILE=/etc/ssl/emqx/emqx_key.rsa
TLS_CA_FILE=/etc/ssl/emqx/emqx.ca-bundle.crt

# Log de peticiones HTTP (morgan). Ej.: 'dev', 'combined'
MORGAN_FORMAT=dev

############################################
# LiveLog / Observabilidad en tiempo real
############################################

# Días de retención de archivos NDJSON en backend/outputs/logs
LIVELOG_RETENTION_DAYS=7
# Aplicar control estricto de roles (incluye endpoints LiveLog). 1 = activo
AUTHZ_STRICT=0

############################################
# Salidas (PDF/QR/JSON/Logos)
############################################

# Preferido: OUTPUT_DIR (ruta absoluta o relativa al directorio backend/)
# Si no se define, por defecto: backend/outputs (junto a app.js)
# Ejemplos:
# OUTPUT_DIR=/opt/cotizador/backend/outputs
# OUTPUT_DIR=C:\\Users\\TuUsuario\\cotizador\\backend\\outputs

# Compatibilidad (legacy): si defines OUTPUTS_DIR, se usa como alias de OUTPUT_DIR
# OUTPUTS_DIR=/home/usuario/cotizador/outputs

############################################
# Seguridad / Auth
############################################

JWT_SECRET=cambia-esto-por-una-clave-segura-y-larga
ADMIN_PASSWORD=define-esto-para-proteger-endpoints-admin

############################################
# Frontend / URLs públicas
############################################

# URL pública donde se sirve la app (se usa en PDF/QR y correos)
FRONTEND_URL=http://localhost:5173

# Si el backend se expone en otra URL/origen, define PUBLIC_API_BASE (p. ej. https://emqx.aysafi.com)
# Déjalo vacío cuando frontend y backend comparten dominio.
PUBLIC_API_BASE=

############################################
# SMTP / Correo saliente
############################################

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true para 465 (SMTPS), false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=account@example.com
SMTP_PASS=change-me
# Remitente visible; si se omite, se usa SMTP_USER
SMTP_FROM="Cotizador <account@example.com>"
# Opcionales: timeouts y TLS
SMTP_CONN_TIMEOUT=15000
SMTP_GREET_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=20000
SMTP_TLS_REJECT_UNAUTH=true
SMTP_DEBUG=false
# Destinatarios auxiliares
SMTP_FALLBACK_TO=
SMTP_NOTIFY_TO=

############################################
# Flags avanzados / desarrollo
############################################

# Forzar verificación laxa TLS (solo pruebas puntuales)
#SKIP_TLS_VERIFY=0
# Depuración adicional
#DEBUG=0

############################################
# Notas
############################################
# 1) Copia este archivo a .env y ajusta los valores.
# 2) En producción, establece FRONTEND_URL a la URL pública del sitio, por ejemplo:
#    FRONTEND_URL=https://cotizador.tudominio.cl
# 3) Si usas Nginx en 443, deja el backend en HTTP (PORT) y configura el proxy; o bien habilita HTTPS directo.
